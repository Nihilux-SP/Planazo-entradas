# Copia estas variables a tu entorno antes de arrancar Uvicorn.
# En PowerShell: $env:GITHUB_CLIENT_ID = "tu-client-id"

# Base de datos SQLite (por defecto: ./data/planazo.sqlite3)
DATABASE_PATH=

# Secreto JWT en Base64 (mínimo 32 bytes). Genera uno con:
# python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
JWT_SECRET=

# Duración del access token en minutos (por defecto: 15)
JWT_EXPIRATION_MINUTES=15

# OAuth de GitHub: crea una OAuth App en https://github.com/settings/developers
# Homepage URL:            http://localhost:8080
# Authorization callback:  http://localhost:8000/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/oauth/{provider}/callback
FRONTEND_URI=http://localhost:8080/

# Orígenes permitidos por CORS (separados por comas)
CORS_ORIGINS=http://localhost:8080
